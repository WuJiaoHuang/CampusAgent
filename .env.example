# Copy to .env; never commit real keys or JWTs.
# Empty credentials are allowed during initialization; no external requests are made.
CAMPUS_AGENT_LLM_API_KEY=
CAMPUS_AGENT_LLM_BASE_URL=https://api.openai.com/v1
CAMPUS_AGENT_LLM_MODEL=

# Local Java Gateway; for VM deployment use its actual public entry URL.
# Example for the existing Nginx entry: http://192.168.10.102
CAMPUS_AGENT_GATEWAY_URL=http://localhost:8080
CAMPUS_AGENT_JWT_TOKEN=

# Reserved paths only; initialization does not create databases or vectors.
CAMPUS_AGENT_SQLITE_PATH=data/campus_agent.sqlite3
CAMPUS_AGENT_CHROMA_PATH=data/chroma
