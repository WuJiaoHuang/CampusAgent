# Copy to .env; never commit real keys or JWTs.
# Empty credentials are allowed during initialization; no external requests are made.
CAMPUS_AGENT_LLM_API_KEY=
CAMPUS_AGENT_LLM_BASE_URL=https://api.deepseek.com
CAMPUS_AGENT_LLM_MODEL=deepseek-flash
CAMPUS_AGENT_LLM_DISABLE_THINKING=true

# Local Java Gateway; for VM deployment use its actual public entry URL.
# Example for the existing Nginx entry: http://192.168.10.102
CAMPUS_AGENT_GATEWAY_URL=http://localhost:8080
CAMPUS_AGENT_JWT_TOKEN=
CAMPUS_AGENT_JWT_SECRET=
CAMPUS_AGENT_JWT_ALGORITHM=HS512

# Reserved paths only; initialization does not create databases or vectors.
CAMPUS_AGENT_SQLITE_PATH=data/campus_agent.sqlite3
CAMPUS_AGENT_CHROMA_PATH=data/chroma
CAMPUS_AGENT_KNOWLEDGE_DIR=knowledge
CAMPUS_AGENT_VECTOR_DB_PATH=data/chroma
CAMPUS_AGENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CAMPUS_AGENT_MODEL_CACHE_DIR=data/models
CAMPUS_AGENT_EMBEDDING_BATCH_SIZE=16
CAMPUS_AGENT_MAX_TOOL_CALLS_PER_REQUEST=4
CAMPUS_AGENT_MAX_LLM_DECISION_ROUNDS=4

# Optional real integration test variables; keep credentials in the process environment.
# CAMPUS_AGENT_INTEGRATION_GATEWAY=http://192.168.10.102
# CAMPUS_AGENT_INTEGRATION_USERNAME=
# CAMPUS_AGENT_INTEGRATION_PASSWORD=
# CAMPUS_AGENT_INTEGRATION_TRAINING_ID=16001
# CAMPUS_AGENT_INTEGRATION_LESSON_ID=16001
